{
  "name": "@depscan/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Viewer for report.json produced by @depscan/core. Renders findings; contains no analysis logic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "render": "node ./dist/bin.js"
  },
  "dependencies": {
    "@depscan/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
